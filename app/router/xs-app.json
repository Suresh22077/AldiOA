{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "logout": {
    "logoutEndpoint": "/do/logout",
    "logoutPage": "/index.html"
  },
  "routes": [
    {
      "source": "^/odata/v4/oa/(.*)$",
      "target": "/odata/v4/oa/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    },
    {
      "source": "^/index.html$",
      "localDir": "webapp",
      "authenticationType": "none"
    },
    {
      "source": "^/aldi.oa.exceptions/(.*)$",
      "localDir": "webapp",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/aldi.oa.recommendations/(.*)$",
      "localDir": "webapp",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^(.*)$",
      "localDir": "webapp",
      "authenticationType": "none"
    }
  ]
}
