{
  "sap.app": {
    "id": "aldi.oa.recommendations",
    "type": "application",
    "title": "OA Agent Recommendations",
    "description": "Review and approve AI-generated OA assignment recommendations",
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/oa/",
        "type": "OData",
        "settings": { "odataVersion": "4.0" }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "fullWidth": true
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m":            {},
        "sap.ui.core":      {},
        "sap.fe.templates": {}
      }
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "settings": { "synchronizationMode": "None", "operationMode": "Server", "autoExpandSelect": true }
      }
    },
    "routing": {
      "routes": [
        { "pattern": "", "name": "RecommendationsList", "target": "RecommendationsList" },
        {
          "pattern": "Recommendations({key}):?query:",
          "name": "RecommendationsObjectPage",
          "target": "RecommendationsObjectPage"
        }
      ],
      "targets": {
        "RecommendationsList": {
          "type": "Component",
          "id": "RecommendationsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "entitySet": "Recommendations",
              "variantManagement": "Page",
              "initialLoad": true,
              "navigation": {
                "Recommendations": { "detail": { "route": "RecommendationsObjectPage" } }
              }
            }
          }
        },
        "RecommendationsObjectPage": {
          "type": "Component",
          "id": "RecommendationsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": { "entitySet": "Recommendations" }
          }
        }
      }
    }
  }
}
