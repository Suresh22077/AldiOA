{
  "name": "aldi-oa-agent",
  "version": "1.0.0",
  "description": "Intelligent OA Assignment Agent — BTP CAP Application",
  "repository": "https://github.com/Suresh22077/AldiOA",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@sap/cds": "^9",
    "@cap-js/hana": "^2",
    "@sap/xssec": "^4",
    "express": "^4"
  },
  "devDependencies": {
    "@sap/cds-dk": "^8",
    "@cap-js/sqlite": "^2"
  },
  "scripts": {
    "start": "cds-serve",
    "build": "cds build --production",
    "test": "cds bind --exec jest"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "hana-cloud",
        "[development]": {
          "kind": "sqlite",
          "credentials": { "database": ":memory:" }
        }
      }
    }
  }
}
